// interactive history browser: pick two compiles, diff them
const compareTui = async opts => {
  if (opts.sizeGraph != null) {
    writeSizeGraph(opts.sizeGraph);
    return;
  }

  const history = readHistory().filter(x => x.time != null && x.bundle && x.stage1C && x.porf);
  if (history.length < 2) {
    console.log(dim(`need at least 2 recorded compiles (${compileHistory})`));
    return;
  }

  const max = Math.min(history.length, Math.max(4, (process.stdout.rows ?? 24) - 6));
  const entries = history.slice(-max).reverse(); // newest first
  const pad2 = n => String(n).padStart(2, '0');
  const stamp = x => {
    const d = new Date(x.time);
    return `${pad2(d.getMonth() + 1)}-${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
  };
  const kindText = x => {
    const kind = entryKind(x.build);
    return kind === 'release' ? yellow('release') : kind === 'debug' ? cyan('debug  ') : dim('?      ');
  };
  const entryText = x =>
    `${stamp(x)}  ${relativeAge(Date.now() - x.time).padStart(9)}  c ${currentSizeText(x.stage1C).padStart(8)}  binary ${currentSizeText(x.porf).padStart(8)}`;

  const tty = process.stdin.isTTY && process.stdout.isTTY;
  if (!tty) {
    for (const x of entries) console.log(`  ${kindText(x)}  ${entryText(x)}`);
    console.log(dim('tty required to select and compare'));
    return;
  }

  let cursor = 0;
  const selected = [];
  const lineFor = i => {
    const x = entries[i];
    const cur = i === cursor ? cyan('>') : ' ';
    const sel = selected.includes(i) ? green(selected[0] === i ? 'a' : 'b') : ' ';
    return ` ${cur}${sel} ${kindText(x)}  ${i === cursor ? entryText(x) : dim(entryText(x))}`;
  };
  const footer = dim('↑/↓ move · space/enter select two · q cancel');
  const paint = first => {
    if (!first) process.stdout.write(`\x1b[${entries.length + 1}A`);
    for (let i = 0; i < entries.length; i++) process.stdout.write(`\x1b[2K${lineFor(i)}\n`);
    process.stdout.write(`\x1b[2K${footer}\n`);
  };

  // key queue: a stdin chunk can hold several keypresses; keep escape sequences whole
  const keys = [];
  let waiter = null, ended = false;
  const wake = () => { if (waiter) { const w = waiter; waiter = null; w(); } };
  const onData = d => {
    const s = d.toString();
    for (let i = 0; i < s.length; i++) {
      if (s[i] === '\x1b' && s[i + 1] === '[' && i + 2 < s.length) { keys.push(s.slice(i, i + 3)); i += 2; }
        else keys.push(s[i]);
    }
    wake();
  };
  const onEnd = () => { ended = true; wake(); };
  const nextKey = async () => {
    while (keys.length === 0) {
      if (ended) return null;
      await new Promise(resolve => waiter = resolve);
    }
    return keys.shift();
  };

  process.stdin.setRawMode(true);
  process.stdin.resume();
  process.stdin.on('data', onData);
  process.stdin.on('end', onEnd);
  process.stdout.write('\x1b[?25l');
  const cleanup = () => {
    process.stdout.write('\x1b[?25h');
    process.stdin.removeListener('data', onData);
    process.stdin.removeListener('end', onEnd);
    process.stdin.setRawMode(false);
    process.stdin.pause();
  };

  try {
    paint(true);
    while (selected.length < 2) {
      const k = await nextKey();
      if (k == null || k === 'q' || k === '\x03' || k === '\x1b') return;
      if (k === '\x1b[A' || k === 'k') cursor = (cursor + entries.length - 1) % entries.length;
        else if (k === '\x1b[B' || k === 'j') cursor = (cursor + 1) % entries.length;
        else if (k === ' ' || k === '\r' || k === '\n') {
          const at = selected.indexOf(cursor);
          if (at !== -1) selected.splice(at, 1);
            else selected.push(cursor);
        }
      paint();
    }
  } finally {
    cleanup();
  }

  // first chosen (a) = current, second (b) = baseline
  const [ current, baseline ] = selected.map(i => entries[i]);
  const ageText = x => x === entries[0] ? 'now' : relativeAge(Date.now() - x.time);
  console.log(`  ${dim(`selfhosted ${ageText(current)} vs ${ageText(baseline)}`)}`);
  printComparison(current, baseline);
};

const clean = () => {
  for (const file of fs.readdirSync(selfhostDir)) {
    if (
      file === 'build.mjs' ||
      file === 'native.js'
    ) continue;

    fs.rmSync(path.join(selfhostDir, file), { recursive: true, force: true });
  }
  fs.rmSync(tmpDir, { recursive: true, force: true });
  console.log(green('clean ok'));
};

const main = async () => {
  const { cmd, opts } = parseArgs(process.argv.slice(2));
  fs.mkdirSync(selfhostDir, { recursive: true });
  fs.mkdirSync(tmpDir, { recursive: true });

  if (cmd === 'help' || cmd === '--help' || cmd === '-h') usage();
  else if (cmd === 'bundle') await buildBundle(opts);
  else if (cmd === 'compile') await compileSelfhost(opts);
  else if (cmd === 'verify') await verify(opts);
  else if (cmd === 'bench') await bench(opts);
  else if (cmd === 'c') await c(opts);
  else if (cmd === 'native') await native(opts);
  else if (cmd === 'compare') await compareTui(opts);
  else if (cmd === 'all') {
    await compileSelfhost(opts);
    await verify(opts);
  } else if (cmd === 'clean') clean();
  else {
    usage();
    process.exit(2);
  }
};

await main();
