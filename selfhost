const formatCompileTime = ms => ms >= 1000 ? `${(ms / 1000).toFixed(2)}s` : `${ms.toFixed(0)}ms`;

async function runCompileStep(label, cmd, args, { env = {} } = {}) {
  if (process.stdout.isTTY) process.stdout.write(`${dim('[.....]')} ${label}`);

  const start = performance.now();
  const child = spawn(cmd, args, {
    env: { ...process.env, ...env },
    stdio: [ 'ignore', 'pipe', 'pipe' ]
  });

  let stdout = '';
  let stderr = '';
  child.stdout.setEncoding('utf8');
  child.stderr.setEncoding('utf8');
  child.stdout.on('data', x => stdout += x);
  child.stderr.on('data', x => stderr += x);

  const rc = await new Promise(resolve => child.on('close', resolve));
  const prefix = dim(`[${formatCompileTime(performance.now() - start)}]`);

  if (process.stdout.isTTY) process.stdout.write('\r\x1b[0K');
  if (rc === 0) {
    process.stdout.write(`${prefix} ${green(label)}\n`);
    return;
  }

  process.stdout.write(`${prefix} ${red(label)}\n`);
  if (stdout) process.stdout.write(stdout);
  if (stderr) process.stderr.write(stderr);
  fail(label, `rc=${rc}`);
  process.exit(rc || 1);
}

let transientMode = false;
const transientLog = text => {
  process.stdout.write(text);
};

const pass = (label, details = '') => console.log(`${dim('[')}${green('ok')}${dim(']')} ${label}${details ? ` ${dim(details)}` : ''}`);
const fail = (label, details = '') => console.log(`${dim('[')}${red('fail')}${dim(']')} ${label}${details ? ` ${dim(details)}` : ''}`);
const casePass = (label, details = '') => console.log(`  ${dim('[')}${green('ok')}${dim(']')} ${label}${details ? ` ${dim(details)}` : ''}`);
const caseFail = (label, details = '') => console.log(`  ${dim('[')}${red('fail')}${dim(']')} ${label}${details ? ` ${dim(details)}` : ''}`);

const run = async (label, cmd, args, log, opts, { monitor = false, env = {}, quiet = false, silent = false } = {}) => {
  const verbose = opts.verbose && !silent;
  const transient = transientMode && !silent;
  const capture = quiet || silent || (!verbose && !transient);
  if (verbose || transient) {
    const text = `${printedCommand ? '\n' : ''}${dim('$')} ${commandText(cmd, args)}\n`;
    if (verbose) process.stdout.write(text);
      else transientLog(text);
    printedCommand = true;
  }
  if (log) {
    if (verbose || transient) {
      const text = `${dim(`log ${log}`)}\n`;
      if (verbose) process.stdout.write(text);
        else transientLog(text);
    }
    fs.mkdirSync(path.dirname(log), { recursive: true });
    fs.writeFileSync(log, '');
  }

  if (!monitor || !opts.monitor) {
    const child = spawn(cmd, args, {
      env: { ...process.env, ...env },
      stdio: log || capture ? [ 'ignore', 'pipe', 'pipe' ] : 'inherit'
    });
    const stream = log ? fs.createWriteStream(log, { flags: 'a' }) : null;
    let stdout = '';
    let stderr = '';
    if (stream) {
      child.stdout.pipe(stream);
      child.stderr.pipe(stream);
    }
    if (capture) {
      child.stdout.setEncoding('utf8');
      child.stderr.setEncoding('utf8');
      child.stdout.on('data', x => stdout += x);
      child.stderr.on('data', x => stderr += x);
    } else if (transient && log) {
      child.stdout.on('data', x => transientLog(x.toString()));
      child.stderr.on('data', x => transientLog(x.toString()));
    }

    const rc = await new Promise(resolve => child.on('close', resolve));
    stream?.end();
    if (log && verbose) tail(log, 80);
    if (log && transient) {
      const text = fs.readFileSync(log, 'utf8');
      if (text) transientLog(text);
    }
    if (rc !== 0) {
      fail(label, `rc=${rc}${log ? ` log=${log}` : ''}`);
      if (!verbose) {
        console.log(`\n${dim('$')} ${commandText(cmd, args)}`);
        if (log) console.log(dim(`log ${log}`));
      }
      if (capture && stdout) process.stdout.write(stdout);
      if (capture && stderr) process.stderr.write(stderr);
      if (log && silent) tail(log, 80);
      process.exit(rc || 1);
    }
    return;
  }

  const lldbLog = lldbLogPath(path.basename(log, '.log'));
  fs.writeFileSync(lldbLog, '');
  const child = spawn(cmd, args, {
    env: { ...process.env, ...env },
    stdio: [ 'ignore', 'pipe', 'pipe' ]
  });
  const stream = fs.createWriteStream(log, { flags: 'a' });
  child.stdout.pipe(stream);
  child.stderr.pipe(stream);
  if (transient) {
    child.stdout.on('data', x => transientLog(x.toString()));
    child.stderr.on('data', x => transientLog(x.toString()));
  }

  const start = Date.now();
  let lastLines = 0;
  let lastStack = 0;
  const pid = child.pid;
  if (verbose || transient) {
    const text = `${dim(`pid ${pid}`)}\n`;
    if (verbose) process.stdout.write(text);
      else transientLog(text);
  }

  const timer = setInterval(() => {
    const elapsed = Math.floor((Date.now() - start) / 1000);
    const ps = spawnSync('ps', [ '-o', 'rss=', '-p', String(pid) ], { encoding: 'utf8' });
    const rssKb = +(ps.stdout.trim() || 0);
    const rss = rssKb ? `${Math.floor(rssKb / 1024)}mb` : 'unknown';
    const elapsedText = elapsed >= 60 ? `${Math.floor(elapsed / 60)}m ${elapsed % 60}s` : `${elapsed}s`;
    if (verbose || transient) {
      const text = `${dim(elapsedText)} ${dim(`pid=${pid}`)} ${bold(rss)}\n`;
      if (verbose) process.stdout.write(text);
        else transientLog(text);
    }

    const text = fs.existsSync(log) ? fs.readFileSync(log, 'utf8') : '';
    const lines = text.split('\n');
    if ((verbose || transient) && lines.length - 1 > lastLines) {
      const text = lines.slice(lastLines, -1).join('\n') + '\n';
      if (verbose) process.stdout.write(text);
        else transientLog(text);
      lastLines = lines.length - 1;
    }

    if (opts.stackEvery > 0 && elapsed - lastStack >= opts.stackEvery) {
      lastStack = elapsed;
      sampleStack(pid, elapsedText, rss, lldbLog);
    }
  }, Math.max(1, opts.pollEvery) * 1000);

  const stop = () => {
    if (!child.killed) child.kill('SIGKILL');
  };
  process.once('SIGINT', stop);
  process.once('SIGTERM', stop);

  const rc = await new Promise(resolve => child.on('close', resolve));
  clearInterval(timer);
  stream.end();
  process.removeListener('SIGINT', stop);
  process.removeListener('SIGTERM', stop);
  if (rc !== 0) {
    fail(label, `rc=${rc}${log ? ` log=${log}` : ''}`);
    if (!verbose) {
      console.log(`${dim('$')} ${commandText(cmd, args)}`);
      if (log) console.log(dim(`log ${log}`));
      console.log(dim(`pid ${pid}`));
    }
    tail(log, 80);
    process.exit(rc || 1);
  }
  if (verbose) tail(log, 80);
};

const runCapture = async (label, cmd, args, opts, { env = {}, silent = false } = {}) => {
  const verbose = opts.verbose && !silent;
  if (verbose) console.log(`\n${dim('$')} ${commandText(cmd, args)}`);
  const child = spawn(cmd, args, {
    env: { ...process.env, ...env },
    stdio: [ 'ignore', 'pipe', 'pipe' ]
  });

  let stdout = '';
  let stderr = '';
  child.stdout.setEncoding('utf8');
  child.stderr.setEncoding('utf8');
  child.stdout.on('data', x => stdout += x);
  child.stderr.on('data', x => stderr += x);

  const rc = await new Promise(resolve => child.on('close', resolve));
  if (rc !== 0) {
    if (!verbose) console.log(`\n${dim('$')} ${commandText(cmd, args)}`);
    if (stdout) process.stdout.write(stdout);
    if (stderr) process.stderr.write(stderr);
    fail(label, `rc=${rc}`);
    process.exit(rc || 1);
  }

  return { stdout, stderr, rc };
};

const showDiff = (expected, actual, opts, { beforeCommand = '\n' } = {}) => {
  let diffExpected = expected;
  let diffActual = actual;

  const diffExt = path.extname(diffExpected);
  if (opts.splitDiff && (diffExt === '.wat' || diffExt === '.c') && diffExt === path.extname(diffActual)) {
    const args = [
      '--display', 'side-by-side-show-both',
      '--color', color ? 'always' : 'never',
      ...(process.stdout.columns ? [ '--width', String(process.stdout.columns) ] : []),
      '--context', String(opts.diffContext),
      diffActual,
      diffExpected
    ];

    console.log(`${beforeCommand}${dim('$')} ${commandText('difft', args)}`);
    const result = spawnSync('difft', args, {
      encoding: 'utf8',
      maxBuffer: 16 * 1024 * 1024
    });
    if (result.error) {
      console.log(red('difft failed'), dim(result.error.message));
      process.exit(1);
    }
    const lines = (result.stdout ?? '').split('\n');
    const out = lines.map((line, i) => {
      if (!/ --- [0-9]+\/[0-9]+ --- /.test(stripAnsi(line))) return line;

      const next = lines.slice(i + 1).map(stripAnsi).find(x => x && !/ --- [0-9]+\/[0-9]+ --- /.test(x));
      const matches = next ? [ ...next.matchAll(/\s{2,}(?:[0-9]+|\.\.\.)\s/g) ] : [];
      const rightColumn = matches[1] ? matches[1].index + matches[1][0].search(/[0-9.]/) : 40;
      return `${red('selfhost')}${' '.repeat(Math.max(1, rightColumn - 'selfhost'.length))}${green('host')}`;
    }).join('\n');
    if (out) process.stdout.write(out);
    if (result.stderr) process.stderr.write(result.stderr);
    return;
  }

  const args = [
    '--text', '-',
    '--text-color', color ? 'always' : 'never',
    '--diff-context', String(opts.diffContext),
    '--max-text-report-size', String(512 * 1024),
    '--max-diff-block-lines', '200',
    diffExpected,
    diffActual
  ];

  if (!commandExists('diffoscope')) {
    const fallbackArgs = [
      'diff', '--no-index', '--no-color', `--unified=${opts.diffContext}`, '--',
      diffExpected,
      diffActual
    ];
    console.log(`${beforeCommand}${dim('$')} ${commandText('git', fallbackArgs)}`);
    const fallback = spawnSync('git', fallbackArgs, {
      encoding: 'utf8',
      maxBuffer: 1024 * 1024
    });
    if (fallback.error) {
      console.log(red('git diff failed'), dim(fallback.error.message));
      process.exit(1);
    }
    if (fallback.stdout) process.stdout.write(fallback.stdout);
    if (fallback.stderr) process.stderr.write(fallback.stderr);
    return;
  }

  console.log(`${beforeCommand}${dim('$')} ${commandText('diffoscope', args)}`);
  const result = spawnSync('diffoscope', args, {
    encoding: 'utf8',
    maxBuffer: 1024 * 1024
  });

  if (result.error) {
    console.log(red('diffoscope failed'), dim(result.error.message));
    process.exit(1);
  }

  if (result.stdout) process.stdout.write(result.stdout);
  if (result.stderr) process.stderr.write(result.stderr);
};

