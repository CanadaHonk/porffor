const parseArgs = argv => {
  const opts = { ...defaultOpts, porfFlags: [ ...defaultOpts.porfFlags ] };
  const rest = [];

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--no-monitor') opts.monitor = false;
    else if (arg === '--native-checks') opts.nativeChecks = true;
    else if (arg === '--no-verify') opts.verifyBench = false;
    else if (arg === '--noop-precompiled') opts.noopPrecompiled = true;
    else if (arg.startsWith('--bench-runs=')) opts.benchRuns = +arg.slice('--bench-runs='.length);
    else if (arg === '--detail') opts.detail = true;
    else if (arg === '--no-split-diff') opts.splitDiff = false;
    else if (arg === '--split-diff') opts.splitDiff = true;
    else if (arg === '--release') {
      opts.compiler = process.env.SELFHOST_RELEASE_CC ?? process.env.CC ?? 'cc';
      opts.ccOpts = [ '-O3', '-flto=thin' ];
      opts.release = true;
    }
    else if (/^-O(?:[0-3g]|fast|s|z)$/.test(arg)) {
      opts.ccOpts = opts.ccOpts.filter(x => !/^-O(?:[0-3g]|fast|s|z)$/.test(x));
      opts.ccOpts.unshift(arg);
    }
    else if (arg.startsWith('--cc-opts=')) opts.ccOpts = arg.slice('--cc-opts='.length).split(/\s+/).filter(Boolean);
    else if (arg === '--tcc') opts.compiler = process.env.TCC ?? 'tcc';
    else if (arg.startsWith('--tcc=')) opts.compiler = arg.slice('--tcc='.length);
    else if (arg.startsWith('--diff-context=')) opts.diffContext = +arg.slice('--diff-context='.length);
    else if (arg.startsWith('--poll=')) opts.pollEvery = +arg.slice('--poll='.length);
    else if (arg.startsWith('--compare=')) opts.compare = arg.slice('--compare='.length);
    else if (arg === '--compare') opts.compare = argv[++i] ?? '1';
    else if (arg.startsWith('--size-graph=')) opts.sizeGraph = arg.slice('--size-graph='.length);
    else if (arg === '--size-graph') opts.sizeGraph = argv[i + 1]?.[0] === '-' || argv[i + 1] == null ? inTmp('size.svg') : argv[++i];
    else if (arg.startsWith('--svg=')) opts.sizeGraph = arg.slice('--svg='.length);
    else if (arg === '--svg') opts.sizeGraph = argv[i + 1]?.[0] === '-' || argv[i + 1] == null ? inTmp('size.svg') : argv[++i];
    else if (arg.startsWith('--skip=')) opts.skip = arg.slice('--skip='.length).split(',').map(x => x.trim()).filter(Boolean);
    else if (arg === '--skip-bundle') opts.skipBundle = true;
    else if (arg.startsWith('--stack=')) opts.stackEvery = +arg.slice('--stack='.length);
    else if (arg === '-v') opts.verbose = true;
    else if (arg[0] === '-') opts.porfFlags.push(arg); // unknown flags pass through to porf
    else rest.push(arg);
  }

  if (isTinyCC(compilerArgs(opts))) opts.ccOpts = opts.ccOpts.filter(x => !x.startsWith('-flto'));

  return { cmd: rest[0] ?? 'help', opts };
};

