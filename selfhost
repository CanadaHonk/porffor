const isTinyCC = compiler => path.basename(compiler[0]) === 'tcc';

const compilerArgs = opts => {
  const compiler = opts.compiler.split(/\s+/).filter(Boolean);
  if (compiler.length === 0) compiler.push('cc');

  if (path.basename(compiler[0]) === 'tcc' && compiler.every(x => !x.startsWith('-B'))) {
    const base = path.dirname(compiler[0]);
    if (base !== '.' && fs.existsSync(path.join(base, 'libtcc1.a'))) compiler.push(`-B${base}`);
      else if (fs.existsSync(path.join(homeTcc, 'libtcc1.a'))) compiler.push(`-B${homeTcc}`);
  }
  if (process.platform === 'darwin' && isTinyCC(compiler))
    compiler.push('-D_XOPEN_SOURCE=600', '-D_DARWIN_C_SOURCE');

  return compiler;
};

