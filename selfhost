const stripAnsi = x => x.replace(/\x1B\[[0-?]*[ -/]*[@-~]/g, '');
const trimEndAnsi = text => {
  let end = text.length;
  const suffix = [];
  while (end > 0) {
    const ansi = text.slice(0, end).match(/\x1B\[[0-?]*[ -/]*[@-~]$/);
    if (ansi) {
      suffix.unshift(ansi[0]);
      end -= ansi[0].length;
    } else if (text[end - 1] === ' ') {
      end--;
    } else {
      break;
    }
  }
  return text.slice(0, end) + suffix.join('');
};
