const patchMachOStackSize = (file, stackSize = 0x4000000n) => {
  if (process.platform !== 'darwin') return;

  const buf = fs.readFileSync(file);
  if (buf.length < 32 || buf.readUInt32LE(0) !== 0xfeedfacf) return;

  const ncmds = buf.readUInt32LE(16);
  let off = 32;
  for (let i = 0; i < ncmds && off + 8 <= buf.length; i++) {
    const cmd = buf.readUInt32LE(off);
    const cmdsize = buf.readUInt32LE(off + 4);
    if (cmd === 0x80000028 && cmdsize >= 24 && off + 24 <= buf.length) {
      if (buf.readBigUInt64LE(off + 16) !== stackSize) {
        buf.writeBigUInt64LE(stackSize, off + 16);
        fs.writeFileSync(file, buf);
        spawnSync('codesign', [ '-s', '-', '-f', file ], { stdio: 'ignore' });
      }
      return;
    }
    if (cmdsize < 8) return;
    off += cmdsize;
  }
};

