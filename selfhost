const compareFiles = async (label, expected, actual, opts, { grouped = false, debugRerun = null } = {}) => {
  const expectedBytes = fs.readFileSync(expected);
  const actualBytes = fs.readFileSync(actual);
  if (expectedBytes.equals(actualBytes)) {
    (grouped ? casePass : pass)(label, `${actualBytes.length}/${expectedBytes.length} bytes match`);
    return;
  }

  (grouped ? caseFail : fail)(label, `${actual} differs from ${expected}`);
  showDiff(expected, actual, opts);
  if (debugRerun) {
    console.log(`\n${bold('-d rerun')}`);
    const [ debugExpected, debugActual ] = await debugRerun();
    if (fs.readFileSync(debugExpected).equals(fs.readFileSync(debugActual))) {
      console.log(dim(`${debugActual} matches ${debugExpected}`));
    } else {
      showDiff(debugExpected, debugActual, opts, { beforeCommand: '' });
    }
  }
  process.exit(1);
};

const verifyParityCase = async ([ name, file, setup, caseOpts = {} ], opts, first = false) => {
  setup?.();
  if (opts.nativeChecks) {
    if (!first) console.log();
    console.log(bold(name));
  }

  const hostC = inTmp(`${name}-host.c`);
  const selfC = inTmp(`${name}-selfhost.c`);
  const nativeTmp = inTmp(`${name}-native-tmp`);
  const hostNative = inTmp(`${name}-host-native`);
  const selfNative = inTmp(`${name}-selfhost-native`);

  await run(`host ${name} to c`, './porf', [ 'c', ...porfDebugArgs(opts), '--profile-compiler', file, '-o', hostC ], null, opts, { silent: true });
  await run(`selfhost ${name} to c`, porf, [ 'c', ...porfDebugArgs(opts), file, '-o', selfC ], logPath(`${name}-c`), opts, { silent: true });
  await compareFiles(opts.nativeChecks ? 'c parity' : `${name} c parity`, hostC, selfC, opts, {
    grouped: opts.nativeChecks,
    debugRerun: async () => {
      const hostDebugC = inTmp(`${name}-host-debug.c`);
      const selfDebugC = inTmp(`${name}-selfhost-debug.c`);
      await run(`host ${name} to c -d`, './porf', [ 'c', '-d', ...porfDebugArgs(opts), '--profile-compiler', file, '-o', hostDebugC ], null, opts, { silent: true });
      await run(`selfhost ${name} to c -d`, porf, [ 'c', '-d', ...porfDebugArgs(opts), file, '-o', selfDebugC ], logPath(`${name}-c-debug`), opts, { silent: true });
      return [ hostDebugC, selfDebugC ];
    }
  });
  if (!opts.nativeChecks) return;

  fs.rmSync(nativeTmp, { force: true });
  await run(`host ${name} to native`, './porf', [ 'native', ...porfDebugArgs(opts), '--profile-compiler', file, '-o', nativeTmp ], null, opts, { silent: true });
  fs.renameSync(nativeTmp, hostNative);
  await run(`selfhost ${name} to native`, porf, [ 'native', ...porfDebugArgs(opts), file, '-o', nativeTmp ], logPath(`${name}-native`), opts, { silent: true });
  fs.renameSync(nativeTmp, selfNative);
  await compareFiles('native binary parity', hostNative, selfNative, opts, {
    grouped: true,
    debugRerun: async () => {
      const hostDebugNative = inTmp(`${name}-host-debug-native`);
      const selfDebugNative = inTmp(`${name}-selfhost-debug-native`);
      const nativeDebugTmp = inTmp(`${name}-native-debug-tmp`);
      fs.rmSync(nativeDebugTmp, { force: true });
      await run(`host ${name} to native -d`, './porf', [ 'native', '-d', ...porfDebugArgs(opts), '--profile-compiler', file, '-o', nativeDebugTmp ], null, opts, { silent: true });
      fs.renameSync(nativeDebugTmp, hostDebugNative);
      await run(`selfhost ${name} to native -d`, porf, [ 'native', '-d', ...porfDebugArgs(opts), file, '-o', nativeDebugTmp ], logPath(`${name}-native-debug`), opts, { silent: true });
      fs.renameSync(nativeDebugTmp, selfDebugNative);
      return [ hostDebugNative, selfDebugNative ];
    }
  });

  const hostRun = await runCapture(`run host ${name} native`, hostNative, [], opts, { silent: true });
  const selfRun = await runCapture(`run selfhost ${name} native`, selfNative, [], opts, { silent: true });
  if (caseOpts.compareNativeOutput === false) {
    casePass('native run', `exit code ${selfRun.rc}`);
    return;
  }

  if (hostRun.stdout === selfRun.stdout && hostRun.stderr === selfRun.stderr) {
    casePass('native output parity', `${hostRun.stdout.length + hostRun.stderr.length} bytes match`);
  } else {
    caseFail('native output parity');
    console.log(dim('host stdout:')); process.stdout.write(hostRun.stdout);
    console.log(dim('selfhost stdout:')); process.stdout.write(selfRun.stdout);
    console.log(dim('host stderr:')); process.stderr.write(hostRun.stderr);
    console.log(dim('selfhost stderr:')); process.stderr.write(selfRun.stderr);
    process.exit(1);
  }
};

