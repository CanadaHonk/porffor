};

const relativeAge = ms => {
  const s = Math.round(ms / 1000);
  if (s < 60) return `${s}s ago`;
  if (s < 3600) return `${Math.round(s / 60)}m ago`;
  if (s < 86400) return `${(s / 3600).toFixed(1)}h ago`;
  return `${(s / 86400).toFixed(1)}d ago`;
};

const resolveCompare = (history, compare) => {
  if (!history.length) return -1;
  const raw = String(compare ?? '1').trim();
  if (/^\d+$/.test(raw)) return Math.max(0, history.length - Math.max(1, +raw));
  const target = Date.parse(raw);
  if (Number.isNaN(target)) return history.length - 1;
  let best = -1, bestDiff = Infinity;
  for (let i = 0; i < history.length; i++) {
    if (history[i].time == null) continue;
    const diff = Math.abs(history[i].time - target);
    if (diff < bestDiff) { bestDiff = diff; best = i; }
  }
  return best === -1 ? history.length - 1 : best;
};

const printComparison = (stats, previous) => {
  const rows = [
    {
      label: 'bundle',
      first: {
        current: reportLines(stats.bundle.lines),
        delta: lineDelta(stats.bundle, previous?.bundle)
      },
      color: cyan,
      second: {
        current: currentSizeText(stats.bundle),
        delta: sizeDelta(stats.bundle, previous?.bundle)
      }
    },
    {
      label: 'c',
      first: {
        current: reportLines(stats.stage1C.lines),
        delta: lineDelta(stats.stage1C, previous?.stage1C)
      },
      color: cyan,
      second: {
        current: currentSizeText(stats.stage1C),
        delta: sizeDelta(stats.stage1C, previous?.stage1C)
      }
    },
    {
      label: 'binary',
      first: {
        current: currentSizeText(stats.porf),
        delta: sizeDelta(stats.porf, previous?.porf)
      },
      color: yellow
    }
  ];
  const firstWidth = Math.max(...rows.map(x => metricPlain(x.first).length));
  const sizeWidth = Math.max(...rows.filter(x => x.second).map(x => x.second.current.length));
  for (const row of rows) reportRow(row, firstWidth, sizeWidth);
};

const showSelfhostReport = opts => {
