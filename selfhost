const plainLength = text => stripAnsi(text).length;
const fit = (text, width, right = false) => {
  const pad = Math.max(0, width - plainLength(text));
  return right ? ' '.repeat(pad) + text : text + ' '.repeat(pad);
};

const benchTime = ms => ms == null ? dim('–') : ms >= 1000 ? `${(ms / 1000).toFixed(2)}s` : `${Math.round(ms)}ms`;
const benchMem = bytes => bytes == null ? dim('–') : bytes >= 1_073_741_824 ? `${(bytes / 1_073_741_824).toFixed(2)}GB` : `${Math.round(bytes / 1_048_576)}MB`;
const ratioColor = ratio => ratio <= 1 ? green : ratio <= 1.5 ? yellow : red;
const benchRatio = ratio => ratio == null ? dim('–') : ratioColor(ratio)(`${ratio.toFixed(2)}×`);
const compilerProfilePhases = [
  [ 'parsed', 'parse' ],
  [ 'generated IR', 'codegen' ],
  [ 'rendered C', 'render' ]
];
const spinnerFrames = [ '⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏' ];
const spinner = () => cyan(spinnerFrames[Math.floor(performance.now() / 80) % spinnerFrames.length]);

const gaugeEighths = [ '', '▏', '▎', '▍', '▌', '▋', '▊', '▉' ];
const benchGauge = (ratio, half) => {
  const mark = dim('█');
  if (ratio == null) return ' '.repeat(half) + mark + ' '.repeat(half);
  const paint = ratioColor(ratio);
  const cells = ratio >= 1 ?
    Math.min(half, Math.max(0, ratio - 1) * half) :
    Math.min(half, Math.max(0, 1 - ratio) * 2 * half);

  if (ratio >= 1) {
    let full = Math.floor(cells);
    let frac = Math.round((cells - full) * 8);
    if (frac === 8) { full++; frac = 0; }
    if (full === 0 && frac === 0 && ratio !== 1) frac = 1;
    const bar = '█'.repeat(full) + gaugeEighths[frac];
    return ' '.repeat(half) + mark + paint(bar) + ' '.repeat(half - bar.length);
  }

  const full = Math.floor(cells);
  const frac = cells - full;
  const partial = full >= half ? '' : frac >= 0.75 ? '█' : frac >= 0.25 || full === 0 ? '▐' : '';
  const bar = partial + '█'.repeat(full);
  return ' '.repeat(half - bar.length) + paint(bar) + mark + ' '.repeat(half);
};

const benchGlyph = row => {
  if (row.status === 'running-host' || row.status === 'running-self') return spinner();
  if (row.status === 'failed') return red('✗');
  if (row.status === 'done') return green('✓');
  return dim('·');
};

const benchStepCell = (row, opts) => {
  const elapsed = benchTime(performance.now() - (row.stepStart ?? performance.now()));
  return yellow(opts.benchRuns > 1 ? `${row.stepRun + 1}/${opts.benchRuns} ${elapsed}` : elapsed);
};

const renderBench = (rows, opts, started) => {
  const cases = rows;
  const done = cases.filter(x => x.hostMs != null && x.selfMs != null);
  const completed = cases.filter(x => x.status === 'done' || x.status === 'failed');
  const showMem = rows.some(x => x.hostRss != null || x.selfRss != null);
  const phases = opts.detail ? compilerProfilePhases : [];
  const w = {
    case: Math.max(9, ...rows.map(x => x.name.length), ...phases.map(x => x[1].length + 2)),
    time: 9 + (opts.benchRuns > 1 ? String(opts.benchRuns).length * 2 + 2 : 0),
    ratio: 7,
    mem: Math.max(8, ...rows.flatMap(x => [ plainLength(benchMem(x.hostRss)), plainLength(benchMem(x.selfRss)) ]))
  };
  const graphCount = showMem ? 2 : 1;
  const graphMin = showMem ? 4 : 8;
  const graphMax = showMem ? 16 : 32;
  const nonGraphCells = [
    w.case + 2,
    w.time,
    w.time,
    w.ratio,
    ...(showMem ? [ w.mem, w.mem, w.ratio ] : [])
  ];
  const nonGraphWidth = nonGraphCells.reduce((n, x) => n + x, 0) + (nonGraphCells.length + graphCount - 1) * 2;
  const graphHeaderText = half => fit('0.5×', half) + '1×' + fit('2×', half - 1, true);
  const graphWidth = half => Math.max(plainLength(graphHeaderText(half)), half * 2 + 1);
  const terminalWidth = process.stdout.columns || 120;
  let half = graphMax;
  while (half > graphMin && 2 + nonGraphWidth + graphCount * graphWidth(half) + 2 > terminalWidth) half--;
  const graphCellWidth = graphWidth(half);
  const graphCell = text => text + ' '.repeat(Math.max(0, graphCellWidth - plainLength(text)));
  const graph = ratio => graphCell(benchGauge(ratio, half));
  const graphHeader = graphCell(dim(graphHeaderText(half)));
  const tableLine = cells => `  ${trimEndAnsi(cells.join('  '))}  `;
  const boldBest = (hostValue, selfValue, hostCell, selfCell) => {
    if (hostValue == null || selfValue == null) return [ hostCell, selfCell ];
    if (hostValue <= selfValue) hostCell = bold(hostCell);
    if (selfValue <= hostValue) selfCell = bold(selfCell);
    return [ hostCell, selfCell ];
  };

  const lines = [ '' ];
  const header = [
    fit(dim('case'), w.case + 2),
    fit(dim('host'), w.time, true),
    fit(dim('self'), w.time, true),
    fit(dim('ratio'), w.ratio, true),
    graphHeader,
    ...(showMem ? [
      fit(dim('host'), w.mem, true),
      fit(dim('self'), w.mem, true),
      fit(dim('ratio'), w.ratio, true),
      graphHeader
    ] : [])
  ].join('  ');
  const tableWidth = plainLength(header);
  lines.push(tableLine([ header ]));

  for (const row of rows) {
    const hostMs = row.hostMs;
    const selfMs = row.selfMs;
    const ratio = hostMs != null && selfMs != null && hostMs > 0 ? selfMs / hostMs : null;
    const parityFail = row.status === 'failed' && !row.failedStep;
    const name = row.status === 'pending' ? dim(row.name) : parityFail ? red(row.name) : row.name;
    let hostCell = row.status === 'running-host' ? benchStepCell(row, opts) :
      row.failedStep === 'host' ? red('fail') : benchTime(hostMs);
    let selfCell = row.status === 'running-self' ? benchStepCell(row, opts) :
      row.failedStep === 'self' ? red('fail') : benchTime(selfMs);
    [ hostCell, selfCell ] = boldBest(hostMs, selfMs, hostCell, selfCell);
    const memRatio = row.hostRss && row.selfRss ? row.selfRss / row.hostRss : null;
    let hostMemCell = benchMem(row.hostRss);
    let selfMemCell = benchMem(row.selfRss);
    [ hostMemCell, selfMemCell ] = boldBest(row.hostRss, row.selfRss, hostMemCell, selfMemCell);
    lines.push(tableLine([
      fit(`${benchGlyph(row)} ${name}`, w.case + 2),
      fit(hostCell, w.time, true),
      fit(selfCell, w.time, true),
      fit(benchRatio(ratio), w.ratio, true),
      graph(ratio),
      ...(showMem ? [
        fit(hostMemCell, w.mem, true),
        fit(selfMemCell, w.mem, true),
        fit(benchRatio(memRatio), w.ratio, true),
        graph(memRatio)
      ] : [])
    ]));

    const rowPhases = opts.detail ? compilerProfilePhases : [];
    for (let i = 0; i < rowPhases.length; i++) {
      const [ phase, label ] = rowPhases[i];
      const hostPhaseMs = row.hostDetail?.[phase] ?? null;
      const selfPhaseMs = row.selfDetail?.[phase] ?? null;
      const phaseRatio = hostPhaseMs != null && selfPhaseMs != null && hostPhaseMs > 0 ? selfPhaseMs / hostPhaseMs : null;
      let hostPhaseCell = benchTime(hostPhaseMs);
      let selfPhaseCell = benchTime(selfPhaseMs);
      [ hostPhaseCell, selfPhaseCell ] = boldBest(hostPhaseMs, selfPhaseMs, hostPhaseCell, selfPhaseCell);
      lines.push(tableLine([
        fit(`  ${dim(`${i === rowPhases.length - 1 ? '└' : '├'} ${label}`)}`, w.case + 2),
        fit(hostPhaseCell, w.time, true),
        fit(selfPhaseCell, w.time, true),
        fit(benchRatio(phaseRatio), w.ratio, true),
        graph(phaseRatio),
        ...(showMem ? [
          fit('', w.mem),
          fit('', w.mem),
          fit('', w.ratio),
          graphCell('')
        ] : [])
      ]));
    }
  }

  if (completed.length === cases.length) {
    const ratios = done.map(x => x.hostMs > 0 && x.selfMs > 0 ? x.selfMs / x.hostMs : null).filter(x => x != null);
    const geomean = ratios.length ? Math.exp(ratios.reduce((n, x) => n + Math.log(x), 0) / ratios.length) : null;
    const rssRatios = done.map(x => x.hostRss > 0 && x.selfRss > 0 ? x.selfRss / x.hostRss : null).filter(x => x != null);
    const rssGeomean = rssRatios.length ? Math.exp(rssRatios.reduce((n, x) => n + Math.log(x), 0) / rssRatios.length) : null;
    lines.push(tableLine([ dim('┈'.repeat(tableWidth)) ]));
    lines.push(tableLine([
      fit('  geomean', w.case + 2),
      fit(dim('–'), w.time, true),
      fit(dim('–'), w.time, true),
      fit(benchRatio(geomean), w.ratio, true),
      graph(geomean),
      ...(showMem ? [
        fit(dim('–'), w.mem, true),
        fit(dim('–'), w.mem, true),
        fit(benchRatio(rssGeomean), w.ratio, true),
        graph(rssGeomean)
      ] : [])
    ]));
  } else {
    lines.push('');
    const width = 24;
    const filled = Math.round(completed.length / cases.length * width);
    lines.push(`  ${spinner()} ${completed.length}${dim(`/${cases.length} cases`)}  ${cyan('█'.repeat(filled))}${dim('░'.repeat(width - filled))}  ${dim(formatTime(performance.now() - started))}`);
  }
  lines.push('');
  return lines;
};

const timeBin = '/usr/bin/time';
const hasTimeMem = fs.existsSync(timeBin);
const timeMemFlag = process.platform === 'linux' ? '-v' : '-l';
const parseMaxRss = text => {
  // BSD/macOS: "<bytes>  maximum resident set size"
  let m = text.match(/^\s*(\d+)\s+maximum resident set size/mi);
  if (m) return +m[1];
  // GNU: "Maximum resident set size (kbytes): <kbytes>"
  m = text.match(/maximum resident set size \(kbytes\):\s*(\d+)/i);
  if (m) return +m[1] * 1024;
  return null;
};

const parseCompilerDetail = text => {
  const detail = {};
  for (const line of stripAnsi(text).split('\n')) {
    const match = line.match(/^\s*(\d+(?:\.\d+)?)ms\s+(.+?)\s*$/);
    if (match) detail[match[2]] = +match[1];
  }
  return detail;
};

const runBenchCompile = async (label, cmd, args, log, failures, detail) => {
  fs.mkdirSync(path.dirname(log), { recursive: true });
  fs.writeFileSync(log, '');
  const fd = fs.openSync(log, 'a');
  const spawnCmd = hasTimeMem ? timeBin : cmd;
  const spawnArgs = hasTimeMem ? [ timeMemFlag, cmd, ...args ] : args;
  const start = performance.now();
  const child = spawn(spawnCmd, spawnArgs, {
    env: { ...process.env, _: cmd },
    stdio: [ 'ignore', fd, hasTimeMem ? 'pipe' : fd ]
  });
  let stderr = '';
  if (hasTimeMem) {
    child.stderr.setEncoding('utf8');
    child.stderr.on('data', x => { stderr += x; fs.writeSync(fd, x); });
  }
  const [ rc, signal ] = await new Promise(resolve => child.on('close', (code, sig) => resolve([ code, sig ])));
  fs.closeSync(fd);
  if (rc !== 0) {
    failures.push({ type: 'compile', label, rc: rc ?? signal, log });
    return null;
  }
  return {
    ms: performance.now() - start,
    rss: hasTimeMem ? parseMaxRss(stderr) : null,
    detail: detail ? parseCompilerDetail(fs.readFileSync(log, 'utf8')) : {}
  };
};

const benchAverage = async (fn, runs) => {
  let total = 0;
  let peakRss = 0;
  const detail = {};
  for (let i = 0; i < runs; i++) {
    const r = await fn(i);
    if (r == null || r.ms == null) return null;
    total += r.ms;
    if (r.rss != null) peakRss = Math.max(peakRss, r.rss);
    for (const [ phase, ms ] of Object.entries(r.detail)) detail[phase] = (detail[phase] ?? 0) + ms;
  }
  for (const phase in detail) detail[phase] /= runs;
  return { ms: total / runs, rss: peakRss || null, detail };
};

const bench = async opts => {
  requireBuiltSelfhost();
  opts.benchRuns = Number.isFinite(opts.benchRuns) && opts.benchRuns > 0 ? Math.floor(opts.benchRuns) : 1;

  let benchHost = './porf';
  if (opts.compare != null) {
    if (!fs.existsSync(opts.compare)) {
      console.log(red(`--compare binary not found: ${opts.compare}`));
      process.exit(1);
    }
    benchHost = opts.compare;
    if (opts.verifyBench) {
      opts.verifyBench = false;
      console.log(dim(`comparing against ${benchHost} (parity check disabled)`));
    } else {
      console.log(dim(`comparing against ${benchHost}`));
    }
  }

  const verifyCases = [
    ...parityCases,
    [ 'selfhost', bundle ]
  ];
  const benchCases = verifyCases.filter(([ name ]) =>
    !opts.skip.includes(name) && (!opts.detail || detailBenchCases.includes(name)));
  warnUnknownSkips(opts, verifyCases.map(x => x[0]));
  const rows = benchCases.map(([ name ]) => ({ name, status: 'pending', hostMs: null, selfMs: null, hostRss: null, selfRss: null, same: null }));
  const started = performance.now();
  const failures = [];
  const tty = process.stdout.isTTY;

  let prevLines = 0;
  const paint = (final = false) => {
    const lines = renderBench(rows, opts, started);
    if (!tty) {
      if (final) console.log(lines.join('\n'));
      return;
    }
    process.stdout.write(
      (prevLines ? `\x1b[${prevLines}F` : '') +
      lines.map(x => `\x1b[2K${x}`).join('\n') + '\n' +
      '\x1b[0J'
    );
    prevLines = lines.length;
  };

  const restoreCursor = () => { if (tty) process.stdout.write('\x1b[?25h'); };
  const onSigint = () => { restoreCursor(); process.exit(130); };
  if (tty) {
    process.stdout.write('\x1b[?25l');
    process.once('SIGINT', onSigint);
  }
  const timer = tty ? setInterval(paint, 100) : null;
  paint();

  try {
    for (let i = 0; i < benchCases.length; i++) {
      const [ name, file, setup ] = benchCases[i];
      setup?.();
      const row = rows[i];
      const hostC = inTmp(`bench-${name}-host.c`);
      const selfC = inTmp(`bench-${name}-selfhost.c`);

      row.status = 'running-host';
      const host = await benchAverage(runId => {
        row.stepStart = performance.now();
        row.stepRun = runId;
        paint();
        return runBenchCompile(`host ${name} c bench`, benchHost, [ 'c', ...porfDebugArgs(opts), '--profile-compiler', file, '-o', hostC ], logPath(`bench-${name}-host-${runId}`), failures, opts.detail);
      }, opts.benchRuns);
      row.hostMs = host?.ms ?? null;
      row.hostRss = host?.rss ?? null;
      row.hostDetail = host?.detail;
      if (row.hostMs == null) {
        row.status = 'failed';
        row.failedStep = 'host';
        continue;
      }

      row.status = 'running-self';
      const self = await benchAverage(runId => {
        row.stepStart = performance.now();
        row.stepRun = runId;
        paint();
        return runBenchCompile(`selfhost ${name} c bench`, porf, [ 'c', ...porfDebugArgs(opts), file, '-o', selfC ], logPath(`bench-${name}-self-${runId}`), failures, opts.detail);
      }, opts.benchRuns);
      row.selfMs = self?.ms ?? null;
      row.selfRss = self?.rss ?? null;
      row.selfDetail = self?.detail;
      if (row.selfMs == null) {
        row.status = 'failed';
        row.failedStep = 'self';
        continue;
      }

      if (opts.verifyBench) {
        row.same = fs.existsSync(hostC) && fs.existsSync(selfC) && fs.readFileSync(hostC).equals(fs.readFileSync(selfC));
        row.status = row.same ? 'done' : 'failed';
        if (!row.same) failures.push({ type: 'parity', name, hostC, selfC });
      } else {
        row.status = 'done';
      }
      paint();
    }
  } finally {
    if (timer) clearInterval(timer);
    if (tty) process.removeListener('SIGINT', onSigint);
    paint(true);
    restoreCursor();
  }

  for (const f of failures) {
    if (f.type === 'compile') {
      fail(f.label, `rc=${f.rc} log=${f.log}`);
      tail(f.log, 40);
    } else {
      fail(`${f.name} c parity`, `${f.selfC} differs from ${f.hostC}`);
      showDiff(f.hostC, f.selfC, opts);
    }
  }
  if (failures.length) process.exitCode = 1;
};

