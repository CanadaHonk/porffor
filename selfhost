const fileLoc = file => {
  const source = fs.readFileSync(file, 'utf8');
  if (source.length === 0) return 0;
  let lines = 1;
  for (let i = 0; i < source.length; i++) {
    if (source.charCodeAt(i) === 10) lines++;
  }
  if (source.charCodeAt(source.length - 1) === 10) lines--;
  return lines;
};

const reportLines = lines => {
  if (lines >= 1_000_000) return `${(lines / 1_000_000).toFixed(3)}M lines`;
  if (lines >= 1_000) return `${(lines / 1_000).toFixed(2)}K lines`;
  return `${formatNumber(lines)} lines`;
};
const reportPercentDelta = (current, previous) => {
  const value = previous === 0 ? 0 : ((current - previous) / previous) * 100;
  const sign = value >= 0 ? '+' : '-';
  return { text: `${sign}${Math.abs(value).toFixed(2)}%`, value };
};
const currentSizeText = stats => {
  const bytes = stats.bytes;
  return bytes >= 1_000_000 ? `${(bytes / 1_000_000).toFixed(2)}MB` : `${(bytes / 1000).toFixed(2)}KB`;
};
const reportDeltaMargin = 0.1;
const deltaColor = delta => Math.abs(delta.percent) <= reportDeltaMargin ? dim : delta.value < 0 ? green : red;
const metricDelta = (current, previous) => {
  if (!previous) return null;
  const percent = reportPercentDelta(current, previous);
  return { text: `(${percent.text})`, percent: percent.value, value: current - previous };
};
const lineDelta = (stats, previous) => metricDelta(stats.lines, previous?.lines);
const sizeDelta = (stats, previous) => metricDelta(stats.bytes, previous?.bytes);
const metricPlain = metric => metric.delta ? `${metric.current} ${metric.delta.text}` : metric.current;
const reportRow = (row, firstWidth, sizeWidth) => {
  const firstPlain = metricPlain(row.first);
  const firstPad = row.second ? ' '.repeat(firstWidth - firstPlain.length) : '';
  const first = row.color(row.first.current) + (row.first.delta ? ` ${deltaColor(row.first.delta)(row.first.delta.text)}` : '') + firstPad;
  const second = row.second ?
    `  ${yellow(row.second.current.padEnd(sizeWidth))}${row.second.delta ? ` ${deltaColor(row.second.delta)(row.second.delta.text)}` : ''}` :
    '';
  console.log(`  ${dim(row.label.padEnd(6))}    ${first}${second}`);
};

const readHistory = () => {
  if (!fs.existsSync(compileHistory)) return [];
  return fs.readFileSync(compileHistory, 'utf8').split('\n').filter(Boolean).flatMap(line => {
    try { return [ JSON.parse(line) ]; } catch { return []; }
  });
};

const svgEscape = value => String(value)
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;');

const niceStep = raw => {
  if (!Number.isFinite(raw) || raw <= 0) return 1;
  const exp = Math.floor(Math.log10(raw));
  const base = 10 ** exp;
  const n = raw / base;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * base;
};

const graphDateText = (time, span) => {
  const d = new Date(time);
  const pad2 = n => String(n).padStart(2, '0');
  const timeText = `${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
  if (span < 36 * 3600_000) return timeText;
  const dateText = `${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  if (span < 180 * 86400_000) return dateText;
  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}`;
};

const graphPointTitle = x =>
  `${entryKind(x.build) ?? 'unknown'} ${new Date(x.time).toLocaleString('en-US')} ${formatSize(x.porf.bytes)}`;

const sizeGraphSvg = history => {
  const entries = history
    .filter(x => x.time != null && x.porf?.bytes != null && (entryKind(x.build) === 'debug' || entryKind(x.build) === 'release'))
    .sort((a, b) => a.time - b.time);
  if (entries.length === 0) return null;

  const width = 960;
  const height = 540;
  const margin = { top: 76, right: 44, bottom: 72, left: 92 };
  const plotWidth = width - margin.left - margin.right;
  const plotHeight = height - margin.top - margin.bottom;
  const minTime = Math.min(...entries.map(x => x.time));
  const maxTime = Math.max(...entries.map(x => x.time));
  const xMin = minTime === maxTime ? minTime - 1 : minTime;
  const xMax = minTime === maxTime ? maxTime + 1 : maxTime;
  const timeSpan = xMax - xMin;

  let yMin = Math.min(...entries.map(x => x.porf.bytes));
  let yMax = Math.max(...entries.map(x => x.porf.bytes));
  const yPad = Math.max(1, (yMax - yMin || yMax * 0.02) * 0.12);
  yMin = Math.max(0, yMin - yPad);
  yMax += yPad;
  const yStep = niceStep((yMax - yMin) / 5);
  yMin = Math.max(0, Math.floor(yMin / yStep) * yStep);
  yMax = Math.ceil(yMax / yStep) * yStep;
  if (yMin === yMax) yMax += yStep;

  const x = time => margin.left + ((time - xMin) / timeSpan) * plotWidth;
  const y = bytes => margin.top + (1 - (bytes - yMin) / (yMax - yMin)) * plotHeight;
  const pointsFor = build => entries.filter(x => entryKind(x.build) === build).map(entry => ({ entry, x: x(entry.time), y: y(entry.porf.bytes) }));
  const pathFor = points => points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
  const yTicks = [];
  for (let tick = yMin; tick <= yMax + yStep / 2; tick += yStep) yTicks.push(tick);
  const xTicks = Array.from({ length: 6 }, (_, i) => xMin + (timeSpan * i) / 5);
  const series = [
    { build: 'debug', label: 'debug', color: '#2563eb', points: pointsFor('debug') },
    { build: 'release', label: 'release', color: '#dc2626', points: pointsFor('release') }
  ];
  const first = new Date(minTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const last = new Date(maxTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  const grid = yTicks.map(tick => {
    const yy = y(tick);
    return `<line x1="${margin.left}" y1="${yy.toFixed(1)}" x2="${width - margin.right}" y2="${yy.toFixed(1)}" class="grid"/><text x="${margin.left - 12}" y="${(yy + 4).toFixed(1)}" class="tick" text-anchor="end">${svgEscape(formatSize(tick))}</text>`;
  }).join('\n    ');
  const xAxis = xTicks.map(tick => {
    const xx = x(tick);
    return `<line x1="${xx.toFixed(1)}" y1="${height - margin.bottom}" x2="${xx.toFixed(1)}" y2="${height - margin.bottom + 6}" class="axis-tick"/><text x="${xx.toFixed(1)}" y="${height - margin.bottom + 26}" class="tick" text-anchor="middle">${svgEscape(graphDateText(tick, timeSpan))}</text>`;
  }).join('\n    ');
  const lines = series.map(({ color, points }) => points.length > 1 ?
    `<path d="${pathFor(points)}" fill="none" stroke="${color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>` :
    '').join('\n    ');
  const dots = series.flatMap(({ build, color, points }) => points.map(p =>
    `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3" fill="${color}" opacity="0.76"><title>${svgEscape(graphPointTitle({ ...p.entry, build }))}</title></circle>`
  )).join('\n    ');
  const legend = series.map(({ label, color, points }, i) => {
    const latest = points.at(-1)?.entry;
    const value = latest ? formatSize(latest.porf.bytes) : 'no data';
    const yy = 104 + i * 28;
    return `<line x1="724" y1="${yy}" x2="754" y2="${yy}" stroke="${color}" stroke-width="3" stroke-linecap="round"/><circle cx="739" cy="${yy}" r="3" fill="${color}"/><text x="766" y="${yy + 5}" class="legend">${svgEscape(label)} <tspan class="legend-value">${svgEscape(value)}</tspan></text>`;
  }).join('\n    ');

  return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" role="img" aria-labelledby="title desc">
  <title id="title">Porffor selfhost binary size over time</title>
  <desc id="desc">Debug and release selfhost compiler binary sizes plotted on one shared axis.</desc>
  <style>
    .bg { fill: #fbfcff; }
    .panel { fill: #ffffff; stroke: #d9e2ef; }
    .grid { stroke: #e7edf5; stroke-width: 1; }
    .axis { stroke: #64748b; stroke-width: 1.2; }
    .axis-tick { stroke: #64748b; stroke-width: 1; }
    .title { fill: #0f172a; font: 700 25px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .subtitle { fill: #64748b; font: 13px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .tick { fill: #64748b; font: 12px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .axis-label { fill: #334155; font: 13px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .legend { fill: #334155; font: 14px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .legend-value { fill: #0f172a; font-weight: 700; }
  </style>
  <rect class="bg" width="${width}" height="${height}"/>
  <rect class="panel" x="24" y="20" width="${width - 48}" height="${height - 40}" rx="14"/>
  <text x="54" y="55" class="title">Selfhost binary size</text>
  <text x="54" y="80" class="subtitle">${svgEscape(entries.length)} compiles, ${svgEscape(first)} to ${svgEscape(last)}</text>
  <g>
    ${grid}
    <line x1="${margin.left}" y1="${height - margin.bottom}" x2="${width - margin.right}" y2="${height - margin.bottom}" class="axis"/>
    <line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${height - margin.bottom}" class="axis"/>
    ${xAxis}
    ${lines}
    ${dots}
    ${legend}
    <text x="${margin.left + plotWidth / 2}" y="${height - 24}" class="axis-label" text-anchor="middle">compile time</text>
    <text transform="translate(28 ${margin.top + plotHeight / 2}) rotate(-90)" class="axis-label" text-anchor="middle">binary size</text>
  </g>
</svg>
`;
};

